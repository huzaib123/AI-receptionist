# ── LLM Configuration ──────────────────────────────────────
# Aura talks to any OpenAI-compatible provider. The defaults use Groq's free
# tier, so clients pay nothing for the AI. Get a key at
# https://console.groq.com/keys and do NOT add a card (a card switches the
# account to pay-as-you-go). Free limits are per Groq account and per model.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile

# Backup model, used automatically when the main one errors or hits its limit.
# Default: Groq llama-3.1-8b-instant on the same key (it has its own free quota).
# Leave LLM_FALLBACK_API_KEY empty to reuse LLM_API_KEY on the same provider.
# Set LLM_FALLBACK_MODEL_NAME=none to turn the backup off.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL_NAME=llama-3.1-8b-instant

# Later, to move to a paid or different provider, change the three LLM_ values, e.g.
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#           LLM_MODEL_NAME=gemini-3.5-flash-lite
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL_NAME=gpt-4o-mini

# Optional: sampling temperature (default: 0.3) and request timeout in seconds
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30

# Legacy: if only OPENAI_API_KEY is set (no LLM_API_KEY), OpenAI gpt-4o-mini is used.
# OPENAI_API_KEY=sk-...

# ── App Configuration ─────────────────────────────────────
# Optional: log level (default: INFO)
LOG_LEVEL=INFO

# Optional: Database connection URL (defaults to sqlite:///./receptionist.db)
# For Postgres, use: postgresql://username:password@localhost:5432/db_name
DATABASE_URL=sqlite:///./receptionist.db

# ── Security ──────────────────────────────────────────
# Admin dashboard API key (change this before deploying!)
ADMIN_API_KEY=dev_secret_key_123

# Max chat requests per IP per minute (rate limiter)
CHAT_RATE_LIMIT_PER_MINUTE=60

# ── Google Calendar ────────────────────────────────────────
# Path to your Google service account JSON key file.
# Leave empty to use stubbed calendar data (no real calendar).
GOOGLE_SERVICE_ACCOUNT_FILE=

# The calendar ID to manage bookings on.
# Use "primary" for the service account's own calendar,
# or the full calendar ID (e.g. abc123@group.calendar.google.com).
GOOGLE_CALENDAR_ID=primary

# ── Business Profile ───────────────────────────────────────
# Per-client branding, services, prices, FAQ and WhatsApp number.
# Copy config/business_profile.example.json and edit it for each client.
BUSINESS_PROFILE_FILE=config/business_profile.json

# ── Business Rules ─────────────────────────────────────────
# IANA timezone (e.g. Asia/Kuala_Lumpur, America/New_York)
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur

# Business opening / closing hours (24‑hour format)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=19

# Working days (0=Monday … 6=Sunday), comma‑separated
BUSINESS_DAYS=0,1,2,3,4,5

# Minutes of buffer between consecutive appointments
BOOKING_BUFFER_MINUTES=15

# How many days ahead to search for available slots
DEFAULT_SLOT_WINDOW_DAYS=14
